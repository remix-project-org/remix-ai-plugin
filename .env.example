# WalletConnect project ID — required for the browser signing page (MetaMask / WC)
# Create a project at https://cloud.walletconnect.com
WALLETCONNECT_PROJECT_ID=

# HTTP port the server listens on (default: 3000)
PORT=3000

# Public base URL of this server — used to build sign URLs, the plugin manifest and the OpenAPI servers entry.
# Must be publicly reachable for Claude / ChatGPT to call it, e.g. https://remix-ai.example.com
BASE_URL=http://localhost:3000

# Optional bearer token. When set, /mcp and /actions/* require `Authorization: Bearer <token>`
# and the manifest advertises bearer auth (use this when publishing a GPT Action).
PLUGIN_AUTH_TOKEN=

# Contact + legal URLs surfaced in the plugin manifest
CONTACT_EMAIL=support@remixlabs.live
LEGAL_URL=https://remix-project.org/terms

# Optional Matomo usage analytics (server-side). Leave empty to disable.
# Only tool, prompt, resource and MCP method names, client names, outcomes and chain IDs are sent — never addresses, hashes or code.
MATOMO_URL=
MATOMO_SITE_ID=

# Optional server-side RPC endpoints per chain ID (keyless public endpoints are used otherwise).
# Supported chains: 1, 11155111, 137, 8453, 84532, 42161, 10
# RPC_URL_1=
# RPC_URL_11155111=
