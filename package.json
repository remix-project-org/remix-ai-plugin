{
  "name": "remix-ai-plugin",
  "version": "1.0.0",
  "description": "Remix Solidity tooling for Claude and ChatGPT \u2014 one MCP server (Claude plugin + ChatGPT connector) plus OpenAPI Actions for custom GPTs",
  "type": "module",
  "scripts": {
    "build": "npm run build:sign && npm run build:widget && tsc",
    "build:sign": "npm install --prefix sign-app && npm run build --prefix sign-app",
    "build:simulate": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:full": "ENABLE_TRANSACT=true node --env-file=.env_main dist/index.js",
    "start:simulate": "ENABLE_TRANSACT=false node --env-file=.env_simulate dist/index.js",
    "dev:server": "npm run build:widget && tsx --env-file-if-exists=.env src/index.ts",
    "dev:full": "npm run build:widget && ENABLE_TRANSACT=true tsx --env-file=.env_main src/index.ts",
    "dev:simulate": "ENABLE_TRANSACT=false tsx --env-file=.env_simulate src/index.ts",
    "dev:sign": "npm run dev --prefix sign-app",
    "package:claude": "npm run package:claude:full",
    "package:claude:full": "node --env-file=.env_main scripts/package-claude.mjs full",
    "package:claude:simulate": "node --env-file=.env_simulate scripts/package-claude.mjs simulate",
    "build:widget": "esbuild widget/sign-widget.ts --bundle --format=esm --minify --target=es2022 --outfile=widget-dist/sign-widget.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@remix-project/remix-solidity": "^0.5.8",
    "ethers": "^6.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
